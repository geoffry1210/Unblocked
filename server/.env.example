# Get this from your Neon project dashboard (Connection Details).
# Neon connection strings already include ?sslmode=require — keep it as-is.
DATABASE_URL=postgres://user:password@ep-xxxx.neon.tech/unblocked?sslmode=require

# Port the REST API + WebSocket server listen on.
# Render sets this automatically in production — only needed for local dev.
PORT=3001

# The URL of your deployed web frontend, for CORS. Update once Phase 2 ships.
WEB_ORIGIN=http://localhost:5173
